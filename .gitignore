# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
.venv
*.egg-info
build/


transcripts/

.cursor-server/
.gitconfig
.ssh/
.local/

.onCreateCommandMarker
.postCreateCommandMarker
.postStartCommandMarker
.updateContentCommandMarker
.bash_history

# VS Code - only ignore personal workspace files, commit shared settings
.vscode/*.code-workspace
.vscode/launch.json

# Python package and config files at root (services have their own)
# Note: pyproject.toml is now tracked for scripts dependencies
/ruff.toml
/pyrightconfig.json

# =============================================================================
# TERRAFORM FILES - CRITICAL TO IGNORE
# =============================================================================

# Terraform state files - NEVER commit these (contain sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files - may contain sensitive data
*.tfplan
*.tfplan.*

# Terraform provider cache and binaries (can be large)
.terraform/

# Terraform variable files with sensitive data
*.tfvars.local
*.auto.tfvars.local
local.tfvars
secrets.tfvars

# Terraform crash log files
crash.log
crash.*.log

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Override files (used for local development)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform backup files from state migrations
terraform.tfstate.backup.*

# =============================================================================
# AWS AND CLOUD PROVIDER FILES
# =============================================================================

# AWS credentials (if accidentally created locally)
.aws/credentials
.aws/config
.aws/cli/cache/

# Environment files that might contain secrets
.env
.env.local
.env.production
.env.staging
.env.development
.env.*.local
.env.external-secrets

# =============================================================================
# ADDITIONAL DEVELOPMENT FILES
# =============================================================================

# Local development overrides
*.local
.cache/

~$*.xlsx

# Claude related
settings.local.json

# Local-only production seeding script
scripts/modules/database/seed_production_data.py

# Local branch DB snapshots
backend/.branch-db/

# Local production branch-db hydration dumps
backup/prod/branch-db/
